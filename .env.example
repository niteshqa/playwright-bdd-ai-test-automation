# Copy to .env (gitignored). Every value is optional for the bundled SauceDemo examples.

# ── Target ─────────────────────────────────────────────────────────────
# App key from config/framework.config.js (default: saucedemo)
APP=
# dev | staging | prod (aliases: stg, stage, qa, production, live). Default: staging
TEST_ENV=
# Blanket URL override — wins over APP/TEST_ENV (e.g. a preview or local build)
BASE_URL=
REPORT_NAME=E2E Regression Report

# ── HTTP Basic-Auth for gated environments (<ENV>_AUTH_USERNAME / _PASSWORD) ──
DEV_AUTH_USERNAME=
DEV_AUTH_PASSWORD=
STAGING_AUTH_USERNAME=
STAGING_AUTH_PASSWORD=
PROD_AUTH_USERNAME=
PROD_AUTH_PASSWORD=

# ── Test data ──────────────────────────────────────────────────────────
# Password for the SauceDemo demo users (defaults to the public demo password)
SAUCE_PASSWORD=
# Domain for generated registration users (use a catch-all/disposable inbox you control)
TEST_EMAIL_DOMAIN=example.com

# ── Safety ─────────────────────────────────────────────────────────────
# Destructive actions on production need ALL of: not CI, this = true, and --headed
ALLOW_PROD_WRITES=false
# Cleanup ledger for records created during runs (json backend by default)
CLEANUP_LEDGER_BACKEND=json
CLEANUP_LEDGER_PATH=cleanup-ledger/records.json

# ── Reporting / email (scripts/send-report-email.js) ───────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=QA Bot
EMAIL_TO=
EMAIL_CC=
# Only email when something failed (heartbeat-style alerting)
EMAIL_ON_FAILURE_ONLY=false
# Smaller reports for email (no videos)
LIGHT_REPORT=false

# ── Optional browser context ───────────────────────────────────────────
GEOLOCATION_LATITUDE=
GEOLOCATION_LONGITUDE=
WORKERS=1
